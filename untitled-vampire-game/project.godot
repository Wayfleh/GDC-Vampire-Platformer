config_version=5

[application]

config/name="Untitled Vampire Game"
run/main_scene="uid://cv7dxn5b40ncr"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://c63xvvcuu15fh"

[autoload]

GlobalData="*uid://bq1n32qfhnrem"
GlobalMusic="*uid://d2lnxbvep06lu"
LevelTransition="*uid://brehqgom45bim"

[display]

window/size/viewport_width=928
window/size/viewport_height=512
window/size/mode=2
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor]

export/convert_text_resources_to_binary=false

[global_group]

Animals="The animals in a given level"

